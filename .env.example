# vLLM v0.28.0 source build. GPU serving validation is still required.
# Copy to .env, build with ./build.sh, then run ./start.sh.

# --- Runtime image -----------------------------------------------------------
# This tag is produced locally by build.sh. No v0.28.0 image is published yet.
IMAGE=vllm-sm12x-nvfp4-dflash2:local-v0280-dflash2-1

# --- Pinned model artifacts (immutable revisions, not floating tags) ---------
# Target: the exact ModelOpt NVFP4 checkpoint shared with the MTP release.
MODEL_ID=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
MODEL_REVISION=69274a0d8dff5dd35bcee8290612f71e03b6e981
# Draft: the all-NVFP4 DFlash2 block drafter (5-layer, 1.92B, W4A16 group-16).
DRAFT_ID=YourHighnessLA/Qwen3.8-27B-DFlash2-NVFP4
DRAFT_REVISION=d913b0b5603a67c26f3edaf7e42a9f8cf89886be
# Local overrides (dev/smoke; leave empty to use the pinned HF ids above):
TARGET_MODEL_DIR=
DRAFT_MODEL_DIR=

# --- Serving -----------------------------------------------------------------
SERVED_MODEL_NAME=qwen3.8-27b-nvfp4-dflash2
BIND_ADDRESS=127.0.0.1
VLLM_PORT=18089
VISION_PORT=8016
HF_TOKEN=
# CPU vision sidecar INT8 dynamic quantization of the ViT tower (1 = on,
# default; 0 = fp32 eager fallback). ~1.5x faster encode, ~0.90 embedding
# cosine similarity vs fp32.
SIDECAR_INT8=1
# Host GPU exposed to the vLLM container (index or UUID). On multi-GPU hosts,
# set this to the Blackwell card (e.g. `1` if it enumerates second, or its UUID)
# so the probe and container both target the same device deterministically.
GPU_DEVICE=0
START_TIMEOUT_SECONDS=3600

# --- Serving profile (carried forward; revalidate capacity on v0.28.0) -------
# DFlash2 K7 = 8 target query tokens per verification step.
NUM_SPECULATIVE_TOKENS=7
DRAFT_KV_CACHE_DTYPE=nvfp4
KV_CACHE_MEMORY_BYTES=8589934592
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
CUDAGRAPH_CAPTURE_SIZES=[8,16,24,32]
MAMBA_SSM_CACHE_DTYPE=bfloat16
